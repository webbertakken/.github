{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [":rebaseStalePrs", ":disableMajorUpdates", ":disableDependencyDashboard"],
  "labels": ["dependencies"],
  "prHourlyLimit": 5,
  "minimumReleaseAge": "36 hours",
  "packageRules": [
    {
      "description": "Automerge minor and patch updates once checks pass",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "description": "Update dev dependencies in a grouped PR",
      "groupName": "devDependencies",
      "matchDepTypes": ["devDependencies", "optionalDependencies", "peerDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "commitMessagePrefix": "chore: "
    },
    {
      "description": "GitHub Actions majors track the runner's Node runtime, so freezing them breaks CI eventually",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["major"],
      "enabled": true,
      "groupName": "GitHub Actions"
    },
    {
      "description": "Keep git hook tooling on its latest major; majors are reviewed, never automerged",
      "matchPackageNames": ["husky", "lint-staged"],
      "matchUpdateTypes": ["major"],
      "enabled": true
    }
  ]
}
