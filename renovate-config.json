{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [":rebaseStalePrs", ":disableDependencyDashboard"],
  "labels": ["dependencies"],
  "prHourlyLimit": 20,
  "prConcurrentLimit": 10,
  "minimumReleaseAge": "20 hours",
  "packageRules": [
    {
      "description": "Automerge minor and patch updates once checks pass; majors always wait for review",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "description": "Update dev dependencies in a grouped PR",
      "groupName": "devDependencies",
      "matchDepTypes": ["devDependencies", "optionalDependencies", "peerDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "commitMessagePrefix": "chore: "
    },
    {
      "description": "Bump GitHub Actions majors together; they track the runner's Node runtime",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["major"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "At most 3 majors open at once: Renovate opens a major only while fewer than 3 of its PRs are open, so minor and patch updates go first",
      "matchUpdateTypes": ["major"],
      "prConcurrentLimit": 3
    }
  ]
}
